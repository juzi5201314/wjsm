      %977 = call %975, this=%973, args=[%46]
      %978 = is_exception %977
      branch %978, bb375, bb374
    bb374:
      store var $6.result, %970
      store var $6.tag, %970
      jump bb372
    bb375:
      %979 = call builtin.exception_value(%977)
