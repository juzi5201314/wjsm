      %21 = const c112
      store var $0.run, %21
      %22 = const c113
      %23 = load var $0.run
      %24 = call %23, this=%22, callsite="run"
      %25 = is_exception %24
      branch %25, bb2, bb1
    bb1:
      %27 = const c121
      %28 = const c122
      %29 = call builtin.promise.then(%24, %27, %28)
